# Copy to .env and fill in ONLY owner-confirmed values. Empty values hide the related UI.
# VITE_* values are public (baked into the site). Never put secrets in a VITE_ variable.

# Production URL (no trailing slash). Enables canonical, og:url, absolute og:image and sitemap.xml.
VITE_SITE_URL=

# Enquiry form backend. Must accept a JSON POST and return 2xx on success.
# Works with Formspree (https://formspree.io/f/<id>), Getform, Basin, or your own endpoint.
# Leave empty: the form validates, then tells the visitor it was NOT sent and offers WhatsApp/Instagram.
VITE_ENQUIRY_ENDPOINT=

# Contact details – owner must confirm before setting.
VITE_PHONE=                 # E.164, e.g. +919812345678
VITE_WHATSAPP_NUMBER=       # digits only with country code, e.g. 919812345678
VITE_EMAIL=

# Address and hours – owner must confirm before setting.
VITE_STREET_ADDRESS=        # e.g. Shop 12, XYZ Market, Raj Nagar
VITE_POSTAL_CODE=           # e.g. 201001
VITE_OPENING_HOURS=         # JSON, e.g. [["Mon – Sat","11:00 AM – 8:00 PM"],["Sunday","By appointment"]]

# --- Server-side only (used by `npm run reviews:fetch`, never shipped to the browser) ---
# Google Places API (New) key with only "Places API (New)" enabled. Billing applies per Google's pricing.
GOOGLE_PLACES_API_KEY=
# Optional – otherwise resolved automatically from the listing name near the map pin.
GOOGLE_PLACE_ID=
